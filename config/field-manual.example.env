# Public runtime
CYVX_FIELD_HOST=127.0.0.1
CYVX_FIELD_PORT=3080
CYVX_FIELD_PUBLIC_BASE_URL=https://field.cyvx.ai
CYVX_FIELD_DATA_DIR=/var/lib/cyvx/field-manual
CYVX_FIELD_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# ManyChat External Request header: X-CYVX-Webhook-Secret
CYVX_MANYCHAT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Kit API v4
KIT_API_KEY=
KIT_TAG_GENERAL_OPERATOR=
KIT_TAG_SECURITY=
KIT_TAG_MOBILE_BUILD=

# Lemon Squeezy
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
