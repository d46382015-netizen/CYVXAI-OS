{
  "name": "cyvx",
  "version": "8.1.0",
  "private": true,
  "type": "commonjs",
  "description": "CYVXAI operating system with durable mission execution, evidence, recovery, and public gateway runtime",
  "scripts": {
    "start": "bash ./run.sh",
    "dev": "CYVX_ALLOW_INSECURE_LOCAL=true bash ./run.sh",
    "public": "node ./api/runtime-v7.js",
    "public:core": "node ./api/public.js",
    "public:test": "node --test ./test/public-runtime.test.js ./test/mission-public-gateway.test.js",
    "worker": "node ./runtime/missions/worker.js",
    "api": "node ./api/secure-production.js",
    "governance": "bash ./run-governance.sh",
    "governance:server": "node ./api/governance.js",
    "cli": "node ./cli/cyvx.js",
    "doctor": "bash ./scripts/doctor.sh",
    "build": "node ./scripts/build.js && node ./scripts/check-v7.js && node ./scripts/package-v7.js",
    "serve": "node ./ui/server.js",
    "status": "node ./status/server.js",
    "test": "node --test ./test/*.test.js ./core/evolution/test/*.test.js",
    "test:governance": "node --test ./test/governance-kernel.test.js ./test/agent-foundry-grants.test.js",
    "test:foundry": "node --test ./test/agent-foundry-grants.test.js",
    "test:ops": "node --test ./test/runtime-supervisor.test.js ./test/ops-overview.test.js ./test/production-baseline.test.js ./test/backup-recovery.test.js ./test/integration-security.test.js ./test/integration-providers.test.js ./test/integration-hub.test.js ./test/mission-runtime.test.js ./test/mission-recovery.test.js ./test/mission-backup-restore.test.js",
    "test:integrations": "node --test ./test/integration-security.test.js ./test/integration-providers.test.js ./test/integration-hub.test.js ./test/mission-public-gateway.test.js",
    "test:ui": "node --test ./test/ui-contract.test.js ./test/mission-runtime.test.js",
    "verify": "bash ./scripts/verify.sh",
    "verify:production": "bash ./scripts/verify.sh",
    "verify:governance": "node ./scripts/verify-governance.js && node ./scripts/verify-foundry.js",
    "verify:foundry": "node ./scripts/verify-foundry.js",
    "verify:integrations": "node ./scripts/verify-integrations-v8.js && npm run test:integrations",
    "verify:production-baseline": "npm run doctor && node ./scripts/verify-production-baseline.js && npm run verify:integrations && node --check ./api/runtime-v7.js && node --check ./api/integrated-production.js && node --check ./status/server.js && npm test && npm run build && npm run backup:verify && npm run cloudflare:plan",
    "github:test": "node --test ./test/github-control-plane.test.js ./test/github-control-plane-advanced.test.js",
    "spark": "node ./spark/server.js",
    "spark:start": "bash ./spark/start.sh",
    "spark:verify": "node --test ./test/spark-runtime.test.js ./test/spark-server.test.js ./test/spark-security.test.js",
    "spark:run": "bash ./spark/start.sh",
    "spark:test": "node --test ./test/spark-runtime.test.js ./test/spark-server.test.js ./test/spark-security.test.js",
    "backup": "bash ./scripts/backup.sh",
    "backup:upload": "node ./scripts/backup-v7.js --upload --prune",
    "backup:verify": "node ./scripts/backup-v7.js --self-test",
    "restore": "bash ./scripts/restore.sh",
    "uptime": "node ./scripts/uptime-check-v7.js",
    "db:migrate": "node -e \"const {createMissionRuntime}=require('./runtime/missions');const r=createMissionRuntime();console.log(r.dbPath);r.close()\"",
    "cloudflare:plan": "CYVX_EDGE_ORIGIN_SECRET=${CYVX_EDGE_ORIGIN_SECRET:-integration-plan-secret-that-is-at-least-32-characters} node ./scripts/provision-cloudflare-v8.js",
    "cloudflare:apply": "node ./scripts/provision-cloudflare-v8.js --apply",
    "oidc:smoke": "node ./scripts/oidc-smoke-v8.js --optional",
    "partner": "node ./scripts/cyvx-partner-cli.js",
    "strategy": "node scripts/cyvx-operating-loop.js",
    "cyvx": "node scripts/cyvx-operating-loop.js",
    "agency:loop": "node scripts/cyvx-agency-loop.js",
    "agency:tick": "node scripts/cyvx-agency-daemon.js",
    "agency:daemon": "node scripts/cyvx-agency-daemon.js start",
    "wiki:generate": "node --check ./scripts/generate-wiki-v2.js && node ./scripts/generate-wiki-v2.js ./dist/wiki",
    "wiki:publish": "bash ./scripts/publish-wiki.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "ws": "^8.21.0"
  }
}
