# Spark + CYVX v8 integration baseline
NODE_ENV=production
CYVX_ENV=production
PORT=3000
CYVX_PUBLIC_HOST=0.0.0.0
CYVX_GATEWAY_INTERNAL_PORT=3001
CYVX_INTERNAL_PORT=3002
CYVX_SPARK_INTERNAL_PORT=3003
CYVX_CONTROL_PORT=3004
CYVX_LEGACY_GATEWAY_INTERNAL_PORT=3102
CYVX_INSTANCE_ID=
CYVX_RELEASE_SHA=

# Durable single-node operational storage
CYVX_DATA_ROOT=/var/lib/cyvx
CYVX_PLATFORM_STATE=/var/lib/cyvx/platform-state.json
SPARK_STATE_FILE=/var/lib/cyvx/spark-state.json
SPARK_ARTIFACT_ROOT=/var/lib/cyvx/worlds
SPARK_LOG=/var/lib/cyvx/logs/spark-runtime.log
CYVX_LOG_PATH=/var/lib/cyvx/logs/cyvx-runtime.jsonl
CYVX_LOG_MAX_BYTES=10485760
CYVX_LOG_MAX_FILES=7
CYVX_GITHUB_WEBHOOK_STORE=/var/lib/cyvx/github-webhooks.json
CYVX_GITHUB_AUTH_STORE=/var/lib/cyvx/github-auth.json

# Bounded execution, approve-by-default feature policy, and live kill switches
CYVX_AUTONOMY=1
CYVX_AUTONOMY_INTERVAL_MS=3000
CYVX_AUTONOMY_MAX_PER_TICK=10
CYVX_APPROVE_BY_DEFAULT=true
CYVX_FEATURE_FLAGS_JSON={"signup.enabled":true,"billing.enabled":true,"analytics.enabled":true,"email.enabled":true,"external_tools.enabled":true,"paid_operations.enabled":true}

# Fail-closed public and operator security
APP_BASE_URL=https://replace-with-cyvx-domain.example
CYVX_API_KEY=replace-with-32-plus-random-characters
CYVX_OWNER_ID=replace-with-owner-id
CYVX_OPERATOR_SESSION_SECRET=replace-with-32-plus-random-characters
CYVX_ALLOW_INSECURE_LOCAL=false

# Full integration requirement switch. Keep false until every required provider secret exists.
CYVX_REQUIRE_INTEGRATIONS=false

# Managed PostgreSQL / PostgREST / Supabase
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-managed-service-role-secret
CYVX_REQUIRE_MANAGED_DATA=true
CYVX_POSTGREST_URL=https://replace-with-project.supabase.co
CYVX_POSTGREST_SERVICE_KEY=replace-with-managed-service-role-secret
CYVX_POSTGREST_SCHEMA=public
CYVX_POSTGREST_TIMEOUT_MS=10000
CYVX_MANAGED_DATA_INTERVAL_MS=60000
CYVX_DATABASE_URL=postgresql://postgres:replace-me@db.replace-with-project.supabase.co:5432/postgres

# Supabase Auth / OIDC / tenant isolation
CYVX_REQUIRE_IDENTITY=false
CYVX_OIDC_ISSUER=https://replace-with-project.supabase.co/auth/v1
CYVX_OIDC_AUDIENCE=authenticated
CYVX_OIDC_JWKS_URL=https://replace-with-project.supabase.co/auth/v1/.well-known/jwks.json
# Use only when the project is configured with a symmetric JWT signer instead of JWKS.
CYVX_OIDC_JWT_SECRET=
CYVX_OIDC_CLOCK_TOLERANCE_SECONDS=30
CYVX_OIDC_JWKS_CACHE_MS=600000
CYVX_SERVICE_TENANT_ID=00000000-0000-4000-8000-000000000000
CYVX_REQUIRE_MFA_FOR_PRIVILEGED=true

# Cloudflare edge / origin bypass protection
CYVX_REQUIRE_EDGE=false
CYVX_EDGE_ORIGIN_HEADER=x-cyvx-edge-secret
CYVX_EDGE_ORIGIN_SECRET=replace-with-32-plus-random-characters
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Supabase Queues / PGMQ and Cron
CYVX_REQUIRE_QUEUE=false
CYVX_QUEUE_NAME=cyvx_jobs
CYVX_QUEUE_WORKER=true
CYVX_QUEUE_VISIBILITY_SECONDS=60
CYVX_QUEUE_BATCH_SIZE=10
CYVX_QUEUE_POLL_MS=3000
CYVX_QUEUE_MAX_ATTEMPTS=5

# Tenant-aware feature flags / OpenFeature adapter
CYVX_REQUIRE_FEATURE_FLAGS=false
CYVX_FEATURE_FLAG_ENVIRONMENT=production
CYVX_FEATURE_FLAG_REFRESH_MS=30000

# Encrypted remote backups and restore drills
CYVX_BACKUP_ENABLED=true
CYVX_BACKUP_UPLOAD=true
CYVX_BACKUP_INTERVAL_MS=21600000
CYVX_BACKUP_INITIAL_DELAY_MS=30000
CYVX_BACKUP_LOCAL_RETENTION=8
CYVX_BACKUP_RETENTION_DAYS=90
CYVX_BACKUP_MAX_BYTES=536870912
CYVX_BACKUP_PREFIX=production
CYVX_BACKUP_BUCKET=cyvx-backups
CYVX_BACKUP_ENCRYPTION_KEY=replace-with-32-plus-random-characters
CYVX_BACKUP_STORAGE_URL=https://replace-with-project.supabase.co/storage/v1
CYVX_BACKUP_STORAGE_TOKEN=replace-with-managed-storage-token
CYVX_BACKUP_STATUS_FILE=/var/lib/cyvx/backup-status.json

# Infrastructure telemetry and incident notifications
OTEL_SERVICE_NAME=cyvxai-os
OTEL_EXPORTER_OTLP_ENDPOINT=https://replace-with-hosted-otel-endpoint.example
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace-with-otel-token
CYVX_ERROR_WEBHOOK_URL=https://replace-with-private-incident-endpoint.example/cyvx-errors
CYVX_INCIDENT_WEBHOOK_URL=https://replace-with-private-incident-endpoint.example/cyvx-incidents
CYVX_STAGING_URL=https://staging.replace-with-cyvx-domain.example
CYVX_PRODUCTION_URL=https://replace-with-cyvx-domain.example
CYVX_UPTIME_TIMEOUT_MS=10000

# Langfuse AI/agent tracing and evaluation
CYVX_REQUIRE_AI_OBSERVABILITY=false
LANGFUSE_OTLP_ENDPOINT=https://replace-with-langfuse-host.example/api/public/otel
LANGFUSE_OTLP_HEADERS=Authorization=Basic replace-with-langfuse-authorization
CYVX_AI_TRACE_CONTENT=false

# Sentry application error tracking
CYVX_REQUIRE_ERROR_TRACKING=false
SENTRY_DSN=https://replace-with-public-key@replace-with-sentry-host.example/1
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1

# PostHog product analytics. Prompts, email addresses, and evidence are never allowlisted.
CYVX_REQUIRE_PRODUCT_ANALYTICS=false
CYVX_PRODUCT_ANALYTICS_ENABLED=true
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
CYVX_ANALYTICS_SALT=replace-with-32-plus-random-characters

# Stripe billing and entitlements
CYVX_REQUIRE_BILLING=false
CYVX_BILLING_ENABLED=true
CYVX_STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_SECRET_KEY=
CYVX_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
CYVX_STRIPE_PRICE_PLANS={"price_starter":"starter","price_growth":"growth","price_enterprise":"enterprise"}

# Transactional email. Choose exactly one provider.
CYVX_REQUIRE_EMAIL=false
CYVX_EMAIL_ENABLED=true
CYVX_EMAIL_PROVIDER=resend
CYVX_EMAIL_FROM=CYVX <noreply@replace-with-cyvx-domain.example>
CYVX_EMAIL_REPLY_TO=support@replace-with-cyvx-domain.example
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# GitHub Actions OIDC and optional external credential broker
CYVX_REQUIRE_WORKLOAD_IDENTITY=false
CYVX_WORKLOAD_IDENTITY_AUDIENCE=cyvx-production
CYVX_WORKLOAD_IDENTITY_EXCHANGE_URL=https://replace-with-credential-broker.example/token
CYVX_WORKLOAD_IDENTITY_SCOPE=deploy migrate backup
CYVX_OIDC_EVIDENCE_FILE=/tmp/cyvx-oidc-evidence.json

# Multi-tenant SaaS service
CYVX_SAAS_HOST=0.0.0.0
CYVX_SAAS_PORT=3300
CYVX_STORE=postgres_rest

# GitHub App integration
CYVX_REQUIRE_GITHUB_APP=true
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PEM=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_STATE_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
